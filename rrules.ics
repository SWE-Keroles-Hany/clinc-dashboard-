BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//clinc_dashboard//RRULE examples//EN

BEGIN:VEVENT
UID:example-daily@clinc_dashboard
DTSTART:20260616T090000Z
RRULE:FREQ=DAILY;INTERVAL=1;COUNT=10
SUMMARY:Daily meeting (10 occurrences)
END:VEVENT

BEGIN:VEVENT
UID:example-weekly@clinc_dashboard
DTSTART:20260616T090000Z
RRULE:FREQ=WEEKLY;BYDAY=MO,WE,FR;UNTIL=20261231T235959Z
SUMMARY:Mon/Wed/Fri meetings until end of 2026
END:VEVENT

BEGIN:VEVENT
UID:example-monthly@clinc_dashboard
DTSTART:20260616T090000Z
RRULE:FREQ=MONTHLY;BYMONTHDAY=15;COUNT=6
SUMMARY:Monthly on the 15th
END:VEVENT

BEGIN:VEVENT
UID:example-yearly@clinc_dashboard
DTSTART:20260616T090000Z
RRULE:FREQ=YEARLY;BYMONTH=6;BYMONTHDAY=16;COUNT=3
SUMMARY:Anniversary (3 years)
END:VEVENT

END:VCALENDAR
